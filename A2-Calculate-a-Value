# This program calculates and displays the slope-intercept equation of the line
# that passes through two points on a 2-dimensional Cartesian coordinate system.

print("This program will calculate and display the slope-intercept equation of the line that passes through two points.")

# Input: X and Y coordinates for two points
x1 = float(input("What is the X-coordinate of the first point: "))
y1 = float(input("What is the Y-coordinate of the first point: "))
x2 = float(input("What is the X-coordinate of the second point: "))
y2 = float(input("What is the Y-coordinate of the second point: "))

# Calculate the slope (m)
slope = (y2 - y1) / (x2 - x1)
# Calculate the y-intercept (b)
intercept = y1 - slope * x1

# Display the result
print(f"The line through points ({x1}, {y1}) and ({x2}, {y2}) has slope-intercept equation:")
print(f"y = {slope}x + {intercept}")

